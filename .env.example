# Copy to .env and edit. docker compose reads this file for both the dev stack and
# the production overlay; docs/DEPLOY.md explains each value.

# --- Database and cache ------------------------------------------------------
POSTGRES_USER=sysml
POSTGRES_PASSWORD=change-me-before-you-expose-this
POSTGRES_DB=sysml
# Only needed when running the app outside compose (the overlay derives it).
DATABASE_URL=postgresql://sysml:change-me-before-you-expose-this@postgres:5432/sysml
REDIS_URL=redis://redis:6379/0

# --- Concurrency and limits --------------------------------------------------
# gunicorn processes. Each one loads its own copy of the RAG stores:
# ~1 GB per worker with SYSML_ENABLE_RAG=1, ~250 MB without.
SYSML_WORKERS=2
# Turns executing at once per worker, and how many may wait behind them.
SYSML_MAX_CONCURRENCY=4
SYSML_MAX_QUEUE=4
# Seconds a queued turn waits for a slot, and the hard deadline per turn.
SYSML_QUEUE_WAIT=10
SYSML_TURN_TIMEOUT=300
# Per-user / per-address budgets: <count>/<window seconds>.
SYSML_RATE_CHAT=20/300
SYSML_RATE_AUTH=10/900
SYSML_RATE_UPLOAD=30/3600

# --- Accounts -----------------------------------------------------------------
# 0 closes registration once the first (administrator) account exists.
SYSML_ALLOW_SIGNUP=1
# 1 needs HTTPS: a Secure cookie is dropped over plain HTTP (dev sets 0).
SYSML_COOKIE_SECURE=1
# Only believe X-Forwarded-For when a proxy sets it: the production overlay turns
# this on, the dev stack (port 8000 published directly) must leave it off.
SYSML_TRUST_PROXY=0
# Extra origins allowed to POST (same-host is always allowed).
SYSML_ALLOWED_ORIGINS=
# 1 answers every turn with a canned stream and no provider call: only for
# scripts/smoke.py and load_test.py against a throwaway deployment.
SYSML_SMOKE=0

# --- Model backend -----------------------------------------------------------
# ollama | openai | openrouter | anthropic. The UI can override these at runtime;
# that saved configuration lives in Postgres, not here.
SYSML_PROVIDER=ollama
SYSML_MODEL=glm-5.3-flash:cloud
SYSML_API_KEY=
SYSML_BASE_URL=
SYSML_TEMPERATURE=0.15
# Per-account endpoints, models and keys are saved in Postgres and edited in the
# settings dialog; the values above stay every other account's default.
# Encrypts those per-account keys at rest (32+ chars, e.g. `openssl rand -hex 32`).
# Without it the key field is refused with a 400 and only keyless endpoints save.
SYSML_SECRET_KEY=
# 1 lets a saved base url resolve to a private address (a local Ollama or a LAN
# gateway); 0 refuses loopback/RFC1918/the metadata endpoint, which is the SSRF
# guard, so it must stay 0 unless those endpoints are the point.
SYSML_ALLOW_PRIVATE_ENDPOINTS=0
# 0 skips the embedding model and the RAG store (chat-only deployments).
SYSML_ENABLE_RAG=1
# Users add their own Tavily key in Settings to search the web.
OLLAMA_HOST=http://host.docker.internal:11434

# --- Services ----------------------------------------------------------------
SYSML_KERNEL_SERVICE_URL=http://sysml-kernel:8888
KERNEL_TIMEOUT=120
SYSML_STATE_DIR=/workspace/state
SYSML_LOG_LEVEL=INFO

# --- TLS ---------------------------------------------------------------------
# nginx/certs must contain these two files (self-signed is fine on a LAN).
TLS_CERT_PATH=nginx/certs/fullchain.pem
TLS_KEY_PATH=nginx/certs/privkey.pem
